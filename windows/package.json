{
  "name": "roomtwin-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "RoomTwin on Windows: open rooms scanned on the iPhone, furnish them, and walk round them in VR.",
  "type": "module",
  "scripts": {
    "predev": "python tools/make_test_room.py public/test-room.ply || echo (no python: the Test room button won't work)",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test-room": "python tools/make_test_room.py public/test-room.ply"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@elevenlabs/client": "^1.30.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "lucide": "^1.61.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "iwer": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
